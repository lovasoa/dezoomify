# Chrome Web Store API credentials (copy to a local `.env`, never commit).
# The OAuth client JSON lives OUTSIDE the repo at:
#   ~/.config/dezoomify-ng/secrets/chrome-webstore-oauth-client.json  (mode 600)
# Only the refresh token goes here (plus an optional emergency extension-ID
# override). This file is a template:
# real values must never be written into any committed file.

# Path override (optional; default is the secure path above).
CHROME_WS_CLIENT_JSON=

# One-time OAuth result: run
#   ./apps/extension/scripts/chrome-webstore-publish.sh authorize
# then paste the refresh token here (local `.env` only, mode 600).
CHROME_WS_REFRESH_TOKEN=

# Store updates target the EXISTING Chrome Web Store listing
# (release/config.toml [extension.chromium]: iapjjopjejpelnfdonefbffahmcndfbm).
# Never create a new store item: the extension ID is public, fixed, and read
# from release/config.toml by default. Set CHROME_WS_EXTENSION_ID below only
# to override that default in an emergency; leave it empty for normal use.
CHROME_WS_EXTENSION_ID=

# Loopback port for the OAuth authorize flow (default 8085; Google accepts
# any 127.0.0.1 port without pre-registration).
CHROME_WS_LOOPBACK_PORT=
