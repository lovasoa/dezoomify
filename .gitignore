/target/
node_modules/
test-results/
/.pnpm-store/
/dist/
/artifacts/
*.log
/target-wasm/
/wasm-package/
# Secrets: OAuth client JSON, tokens, and env files must never be committed.
# Long-term storage lives outside the repo at ~/.config/dezoomify-ng/secrets/.
.env
.env.*
!.env.example
secrets/
client_secret_*.json
*client-secret*.json
*.p12
*.pfx
# Generated wasm glue. The two runtime files are committed: Cloudflare Pages
# serves committed files only, and the site's worker imports the glue from
# /wasm/. Regenerate with `cargo xtask build web`.
wasm/*
!wasm/dezoomify-wasm.js
!wasm/dezoomify-wasm_bg.wasm

# wrangler local state (wrangler pages dev)
/.wrangler/
