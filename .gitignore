/target/
node_modules/
test-results/
/.pnpm-store/
/dist/
/apps/desktop/dist/
/artifacts/
*.log
/target-wasm/
/wasm-package/
# Secrets: OAuth client JSON, tokens, and env files must never be committed.
# Long-term storage lives outside the repo at ~/.config/dezoomify/secrets/.
.env
.env.*
!.env.example
secrets/
client_secret_*.json
*client-secret*.json
*.p12
*.pfx
# Generated website artifacts: nothing generated is committed. The site is
# built at deploy time by the website-deploy workflow (scripts/
# build-site.mjs); regenerate locally with `cargo xtask build web` or the
# individual generators (scripts/sync-web-js.mjs, scripts/build-help.mjs).
# src/worker.js is handwritten, every other .js mirror is generated.
/wasm/
/help/
/src/*.js
!/src/worker.js
/packages/shared-ui/src/*.js
/packages/shared-ui/src/locales/*.js
/packages/browser-runtime/src/*.js
# Extension no-bundler vendor mirrors (test fixtures, never shipped):
# regenerated by scripts/sync-web-js.mjs, never hand-edited.
/apps/extension/src/page/vendor/
/apps/extension/.output/
/apps/extension/.output-test/
/apps/extension/public/
/apps/extension/.wxt/
/node_modules

# Extension build outputs: esbuild staging (dist/), legacy WXT artifacts
# (.wxt/, .output/, .output-test/, public/), and store zips.
/apps/extension/dist/
/apps/extension/.wxt/
/apps/extension/.output/
/apps/extension/.output-test/
/apps/extension/public/

# wrangler local state (wrangler pages dev)
/.wrangler/

# desktop shell build output (workspace member builds into the root target/)
# plus Tauri-generated capability schemas
/apps/desktop/src-tauri/gen/
