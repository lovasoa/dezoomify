{
  "name": "dezoomify",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@9.12.0",
  "dependencies": {
    "@dezoomify/browser-runtime": "workspace:*",
    "@dezoomify/shared-ui": "workspace:*",
    "@dezoomify/wasm-bindings": "workspace:*",
    "markdown-it": "15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "linkedom": "^0.18.13",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "wrangler": "4.145.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "@playwright/test": "1.63.0",
      "playwright": "1.63.0",
      "playwright-core": "1.63.0"
    }
  },
  "scripts": {
    "lint": "biome lint --error-on-warnings .",
    "format": "biome check --write .",
    "check:biome": "biome check .",
    "fix:biome": "biome lint --write --unsafe .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "build": "vite build",
    "test": "node scripts/build-help.mjs && node --import ./test/tsx-loader.mjs --test-reporter=dot --test \"test/*.test.mjs\""
  }
}
