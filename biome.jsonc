{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "functions/**",
      "scripts/**",
      "test/**",
      "fixtures/**/*.js",
      "testdata/scenarios/**/*.js",
      "!testdata/scenarios/**/payloads",
      "packages/**",
      "apps/**",
      "*.js",
      "*.mjs",
      "*.cjs",
      "*.ts",
      "*.tsx",
      "*.json",
      "*.jsonc",
      "*.css",
      "!packages/wasm-bindings/src/generated.d.ts",
      "!apps/desktop/src-tauri/tauri.conf.json",
      "!apps/desktop/src-tauri/capabilities/generated.json",
      "!apps/desktop/src-tauri/dezoomify.json",
      "!apps/**/dist",
      "!apps/extension/.wxt",
      "!apps/extension/.output*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "types": "recommended",
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "style": { "useErrorCause": "error" },
      "suspicious": { "noDeprecatedImports": "error" },
      "nursery": {
        "noFloatingPromises": { "level": "error", "fix": "none" }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/shared-ui/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "The shared UI is host-neutral; inject browser capabilities through its integration.",
                  "document": "The shared UI is host-neutral; use the host-injected Document, never the global one.",
                  "globalThis": "The shared UI is host-neutral; host globals only reach it through injected capabilities.",
                  "fetch": "The shared UI is host-neutral; inject fetching through its integration.",
                  "chrome": "The shared UI must not depend on extension globals.",
                  "tauri": "The shared UI must not depend on desktop globals."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["*browser-runtime*"],
                    "message": "The shared UI imports domain declarations and local utilities, never a browser implementation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/browser-runtime/src/*.ts",
        "!packages/browser-runtime/src/application.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dezoomify/shared-ui",
                      "*shared-ui*/src/index*",
                      "*shared-ui*/src/view*",
                      "*shared-ui*/src/components*",
                      "*shared-ui*/src/presentation*",
                      "*shared-ui*/src/*.tsx",
                      "react",
                      "react/*",
                      "react-dom",
                      "react-dom/*"
                    ],
                    "message": "Browser image and transport operations import pure utilities directly; UI composition belongs in application.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/page-agent/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "chrome": "The in-page runtime runs inside foreign documents; extension APIs are host territory.",
                  "browser": "The in-page runtime runs inside foreign documents; extension APIs are host territory.",
                  "__TAURI_INTERNALS__": "The in-page runtime runs inside foreign documents; desktop globals are host territory.",
                  "__TAURI_EVENT__": "The in-page runtime runs inside foreign documents; desktop globals are host territory.",
                  "__TAURI__": "The in-page runtime runs inside foreign documents; desktop globals are host territory."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["wxt", "wxt/*", "@tauri-apps/*", "react", "chrome", "chrome/*"],
                    "message": "The in-page runtime must not import a host SDK; hosts inject capabilities."
                  },
                  {
                    "group": [
                      "@dezoomify/extension",
                      "@dezoomify/extension/*",
                      "@dezoomify/desktop",
                      "@dezoomify/desktop/*",
                      "**/apps/extension/**",
                      "**/apps/desktop/**"
                    ],
                    "message": "Products never import each other; shared code belongs in a package."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "__TAURI_INTERNALS__": "Use the public @tauri-apps/api modules.",
                  "__TAURI_EVENT__": "Use the public @tauri-apps/api modules.",
                  "__TAURI__": "Use the public @tauri-apps/api modules."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "dezoomify",
                      "dezoomify/*",
                      "@dezoomify/extension",
                      "@dezoomify/extension/*",
                      "**/extension/**"
                    ],
                    "message": "Products never import each other; shared code belongs in a package."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "functions/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@dezoomify/desktop",
                      "@dezoomify/desktop/*",
                      "@dezoomify/extension",
                      "@dezoomify/extension/*",
                      "**/apps/desktop/**",
                      "**/apps/extension/**"
                    ],
                    "message": "Products never import each other; shared code belongs in a package."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/extension/src/**", "apps/extension/entrypoints/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "dezoomify",
                      "dezoomify/*",
                      "@dezoomify/desktop",
                      "@dezoomify/desktop/*",
                      "**/desktop/**"
                    ],
                    "message": "Products never import each other; shared code belongs in a package."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
