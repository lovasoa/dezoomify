{
  "name": "@dezoomify/extension",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "Dezoomify browser extension (Phase 12): finite active-tab scan, browser-session fetch, consented native handoff.",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node ./scripts/build.mjs",
    "build:manifests": "node ./scripts/generate-manifests.mjs",
    "publish:store": "bash ./scripts/chrome-webstore-publish.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
