{
  "name": "@dezoomify/extension",
  "private": true,
  "type": "module",
  "description": "Dezoomify browser extension: finite active-tab scan and browser-session fetch.",
  "scripts": {
    "test": "node --test-reporter=dot --test \"tests/unit/!(job-worker|manifest-policy).test.mjs\"",
    "test:unit": "node --test-reporter=dot --test \"tests/unit/!(job-worker|manifest-policy).test.mjs\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "build": "wxt build --browser chrome && wxt build --browser firefox",
    "package": "wxt zip",
    "publish:store": "bash ./scripts/chrome-webstore-publish.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dezoomify/browser-runtime": "workspace:*",
    "@dezoomify/shared-ui": "workspace:*",
    "@dezoomify/wasm-bindings": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@dezoomify/app-model": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "wxt": "0.21.4"
  }
}
