{
  "name": "@dezoomify/extension",
  "version": "3.0.3",
  "private": true,
  "type": "module",
  "description": "Dezoomify browser extension (Phase 12): finite active-tab scan, browser-session fetch, consented native handoff.",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "wxt build --browser chrome && wxt build --browser firefox",
    "package": "wxt zip",
    "publish:store": "bash ./scripts/chrome-webstore-publish.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dezoomify/browser-runtime": "workspace:*",
    "@dezoomify/shared-ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "wxt": "0.21.4"
  }
}
