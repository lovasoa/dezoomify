{
  "action": {
    "default_title": "Dezoomify",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  },
  "description": "Save full-resolution zoomable images. Finite active-tab scan only; no background monitoring.",
  "host_permissions": [],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "name": "Dezoomify",
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "optional_permissions": ["cookies"],
  "permissions": ["activeTab", "webRequest", "nativeMessaging"],
  "version": "3.0.0"
}
