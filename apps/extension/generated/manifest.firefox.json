{
  "action": {
    "default_icon": {
      "16": "icons/icon16-grey.png",
      "48": "icons/icon48-grey.png",
      "128": "icons/icon128-grey.png"
    },
    "default_title": "Dezoomify"
  },
  "background": {
    "scripts": [
      "background/index.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{14074c89-8a5f-4813-98df-a7117f062871}",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  },
  "description": "Click to monitor the active tab for zoomable images. Explicit-action indefinite monitoring only: one reload, stops on detection, second click, tab close, or navigation; no background monitoring.",
  "host_permissions": [],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "name": "Dezoomify",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "version": "3.0.0",
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "modal/modal.html"
      ]
    }
  ]
}
