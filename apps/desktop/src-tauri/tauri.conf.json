{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "capabilities": [
        "generated"
      ],
      "csp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Dezoomify",
        "url": "index.html",
        "center": true,
        "width": 1100,
        "height": 750
      }
    ],
    "withGlobalTauri": false
  },
  "build": {
    "beforeBuildCommand": "pnpm --filter ./apps/desktop build",
    "beforeDevCommand": "pnpm --filter ./apps/desktop dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "copyright": "GPL-3.0-or-later",
    "identifier": "com.dezoomify.app",
    "protocol": {
      "name": "dezoomify",
      "schemes": [
        "dezoomify"
      ]
    },
    "resources": [],
    "shortDescription": "Dezoomify desktop",
    "targets": "all"
  },
  "identifier": "com.dezoomify.app",
  "productName": "Dezoomify",
  "version": "0.1.0",
  "x-dezoomify": {
    "commands": [
      "answer_choice",
      "cancel_job",
      "query_capabilities",
      "request_destination",
      "start_job"
    ],
    "decoders": [
      "png",
      "jpeg",
      "tiff"
    ],
    "encoders": [
      "png",
      "jpeg",
      "tiff"
    ],
    "eventChannels": [
      "dezoomify://job-state",
      "dezoomify://job-progress",
      "dezoomify://job-output",
      "dezoomify://job-error",
      "dezoomify://deep-link-pending"
    ],
    "fingerprint": "b4bad92b24615c58",
    "nativeHost": {
      "name": "com.dezoomify.native_host"
    },
    "protocol": {
      "max": "1.0",
      "min": "1.0",
      "version": "1.0"
    },
    "updater": {
      "allowlist": [
        "https://updates.dezoomify.example"
      ],
      "channel": "stable",
      "enabled": true,
      "httpsOnly": true,
      "requiresUserConfirm": true
    }
  }
}
