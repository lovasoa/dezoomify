{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Generated desktop capabilities. Do not edit by hand; generated from crates/dezoomify-protocol/src/dto.rs via the desktop capability mode.",
  "identifier": "generated",
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url",
    "dezoomify:allow-answer-choice",
    "dezoomify:allow-cancel-job",
    "dezoomify:allow-pause-job",
    "dezoomify:allow-query-capabilities",
    "dezoomify:allow-open-saved-output",
    "dezoomify:allow-request-destination",
    "dezoomify:allow-resume-job",
    "dezoomify:allow-start-job"
  ],
  "windows": [
    "main"
  ],
  "x-dezoomify": {
    "commands": [
      "answer_choice",
      "cancel_job",
      "open_saved_output",
      "pause_job",
      "query_capabilities",
      "request_destination",
      "resume_job",
      "start_job"
    ],
    "decoders": [
      "png",
      "jpeg",
      "tiff"
    ],
    "encoders": [
      "png",
      "jpeg",
      "tiff",
      "zif",
      "webp"
    ],
    "eventChannels": [
      "dezoomify://job-snapshot",
      "dezoomify://deep-link-pending"
    ],
    "nativeHost": {
      "name": "dev.ophir.dezoomify.native_host"
    },
    "protocol": {
      "max": "2.0",
      "min": "2.0",
      "version": "2.0"
    },
    "updater": {
      "allowlist": [],
      "channel": "stable",
      "enabled": false,
      "httpsOnly": true,
      "requiresUserConfirm": true
    }
  }
}
