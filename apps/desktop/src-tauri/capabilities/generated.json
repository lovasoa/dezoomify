{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Desktop permissions generated by scripts/generate-desktop-capabilities.mjs.",
  "identifier": "generated",
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "dezoomify:allow-answer-partial",
    "dezoomify:allow-cancel-job",
    "dezoomify:allow-dezoomify",
    "dezoomify:allow-get-job-diagnostics",
    "dezoomify:allow-open-saved-output",
    "dezoomify:allow-pause-job",
    "dezoomify:allow-release-job",
    "dezoomify:allow-resume-job"
  ],
  "windows": [
    "main"
  ],
  "x-dezoomify": {
    "commands": [
      "answer_partial",
      "cancel_job",
      "dezoomify",
      "get_job_diagnostics",
      "open_saved_output",
      "pause_job",
      "release_job",
      "resume_job"
    ],
    "decoders": [
      "png",
      "jpeg",
      "tiff"
    ],
    "encoders": [
      "png",
      "jpeg",
      "tiff",
      "zif",
      "webp"
    ],
    "outputFormats": [
      "png",
      "jpeg",
      "tiff",
      "zif",
      "webp",
      "iiif-dir"
    ],
    "eventChannels": [
      "dezoomify://deep-link-pending",
      "dezoomify://partial",
      "dezoomify://progress",
      "dezoomify://registered"
    ],
    "updater": {
      "allowlist": [],
      "channel": "stable",
      "enabled": false,
      "httpsOnly": true,
      "requiresUserConfirm": true
    },
    "deepLink": {
      "name": "dezoomify",
      "schemes": [
        "dezoomify"
      ]
    }
  }
}
