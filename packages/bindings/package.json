{
  "name": "@dezoomify/bindings",
  "version": "0.1.0",
  "private": true,
  "description": "Stable typed subpaths over the generated WASM contract. Types-only: no runtime, no network.",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./protocol": {
      "types": "./src/protocol.d.ts"
    },
    "./engine": {
      "types": "./src/engine.d.ts"
    },
    "./errors": {
      "types": "./src/errors.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  }
}
