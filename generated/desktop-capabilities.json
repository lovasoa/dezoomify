{
  "app": "desktop",
  "bundle": {
    "identifier": "dev.ophir.dezoomify",
    "protocolScheme": "dezoomify"
  },
  "commands": [
    "job_command",
    "open_saved_output",
    "release_job",
    "query_capabilities",
    "request_destination",
    "start_job"
  ],
  "decoders": [
    "png",
    "jpeg",
    "tiff"
  ],
  "encoders": [
    "png",
    "jpeg",
    "tiff",
    "zif",
    "webp"
  ],
  "eventChannels": [
    "dezoomify://job-snapshot",
    "dezoomify://deep-link-pending"
  ],
  "generator": "phase-11 lean shell (canonical: crates/dezoomify-protocol/src/dto.rs)",
  "protocol": {
    "max": "2.0",
    "min": "2.0",
    "version": "2.0"
  },
  "updater": {
    "allowlist": [],
    "channel": "stable",
    "enabled": false,
    "httpsOnly": true,
    "requiresUserConfirm": true
  }
}
