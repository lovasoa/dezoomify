{
  "$comment": [
    "Shared oracle for the dezoomify://open parser. The native shell's parser",
    "is the single validator: consumed by the Rust test",
    "`deep_link_vectors_match_the_shared_oracle` in",
    "apps/desktop/src-tauri/src/deep_link.rs (parse_deep_link) and by the node",
    "test apps/desktop/tests/policy-vectors.test.mjs, which pins that the",
    "frontend refuses every raw value (only the shell parses raw links).",
    "accept pins the full validated triple (sourceUrl, hint, version); reject",
    "names the Rust DeepLinkError class (kebab-case: oversize, invalid-scheme,",
    "missing-field, duplicate-field, unknown-field, unsupported-version,",
    "malformed-encoding, userinfo-forbidden, secret-forbidden,",
    "invalid-source). A case carries comment when it pins a rule that is easy",
    "to break. Keep the list bounded (15-25 cases) and update the parser and",
    "this file together."
  ],
  "cases": [
    {
      "name": "valid-v2-basic",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fitem",
      "accept": {
        "sourceUrl": "https://example.com/item",
        "hint": null,
        "version": 2
      }
    },
    {
      "name": "valid-v1-with-hint",
      "raw": "dezoomify://open?v=1&src=https%3A%2F%2Fexample.com%2Fitem&hint=Zoomify",
      "accept": {
        "sourceUrl": "https://example.com/item",
        "hint": "Zoomify",
        "version": 1
      }
    },
    {
      "name": "valid-src-query-fragment",
      "comment": "The decoded source keeps its own query and fragment intact.",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx%3Fpage%3D2%23frag",
      "accept": {
        "sourceUrl": "https://example.com/x?page=2#frag",
        "hint": null,
        "version": 2
      }
    },
    {
      "name": "valid-cookie-recipe-path-uppercase-scheme",
      "comment": "Secret keys match exactly, never by substring, and URI schemes are case-insensitive.",
      "raw": "dezoomify://open?v=2&src=HTTPS%3A%2F%2Fexample.com%2Fcookie-recipe%2Fitem",
      "accept": {
        "sourceUrl": "HTTPS://example.com/cookie-recipe/item",
        "hint": null,
        "version": 2
      }
    },
    {
      "name": "valid-hint-plus-space",
      "comment": "Hint values decode like form data: \"+\" is a space.",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fitem&hint=Deep+Zoom",
      "accept": {
        "sourceUrl": "https://example.com/item",
        "hint": "Deep Zoom",
        "version": 2
      }
    },
    {
      "name": "valid-hint-empty-null",
      "comment": "An empty hint normalizes to null (absent), never to the empty string.",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fitem&hint=",
      "accept": {
        "sourceUrl": "https://example.com/item",
        "hint": null,
        "version": 2
      }
    },
    {
      "name": "reject-wrong-scheme",
      "raw": "https://open?v=2&src=https%3A%2F%2Fexample.com%2Fx",
      "reject": "invalid-scheme"
    },
    {
      "name": "reject-wrong-host",
      "raw": "dezoomify://openx?v=2&src=https%3A%2F%2Fexample.com%2Fx",
      "reject": "invalid-scheme"
    },
    {
      "name": "reject-envelope-scheme-case",
      "comment": "The envelope scheme is literal; DEZOOMIFY:// is not a handoff envelope.",
      "raw": "DEZOOMIFY://open?v=2&src=https%3A%2F%2Fexample.com%2Fx",
      "reject": "invalid-scheme"
    },
    {
      "name": "reject-src-userinfo",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fuser%3Apass%40example.com%2Fx",
      "reject": "userinfo-forbidden"
    },
    {
      "name": "reject-src-empty-userinfo",
      "comment": "An authority containing \"@\" carries userinfo even when it is empty.",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2F%40example.com%2Fx",
      "reject": "userinfo-forbidden"
    },
    {
      "name": "reject-oversize-envelope",
      "comment": "Total deep-link length is bounded at 2048 bytes.",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%",
      "reject": "oversize"
    },
    {
      "name": "reject-oversize-src-field",
      "comment": "A decoded src beyond the 1024-byte per-field bound is rejected.",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%",
      "reject": "invalid-source"
    },
    {
      "name": "reject-duplicate-field",
      "raw": "dezoomify://open?v=2&v=1&src=https%3A%2F%2Fexample.com%2Fx",
      "reject": "duplicate-field"
    },
    {
      "name": "reject-unknown-field",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx&extra=1",
      "reject": "unknown-field"
    },
    {
      "name": "reject-secret-envelope-field",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx&token=abc",
      "reject": "secret-forbidden"
    },
    {
      "name": "reject-secret-src-token",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx%3Ftoken%3Dabc",
      "reject": "secret-forbidden"
    },
    {
      "name": "reject-secret-src-access-token",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx%3Faccess_token%3Dabc",
      "reject": "secret-forbidden"
    },
    {
      "name": "reject-secret-src-fragment-cookie",
      "comment": "Fragment parameters count too.",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx%23cookie%3D1",
      "reject": "secret-forbidden"
    },
    {
      "name": "reject-secret-src-bare-key",
      "comment": "A bare key with no value still names a credential.",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx%3Ftoken",
      "reject": "secret-forbidden"
    },
    {
      "name": "reject-secret-src-encoded-key",
      "comment": "Percent-encoded key spellings decode like form data: \"%74oken\" is \"token\".",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx%3F%2574oken%3D1",
      "reject": "secret-forbidden"
    },
    {
      "name": "reject-malformed-escape",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2F%ZZ",
      "reject": "malformed-encoding"
    },
    {
      "name": "reject-version-padded",
      "comment": "Versions are plain integers: no padding, sign, or dot.",
      "raw": "dezoomify://open?v=02&src=https%3A%2F%2Fexample.com%2Fx",
      "reject": "unsupported-version"
    },
    {
      "name": "reject-version-future",
      "raw": "dezoomify://open?v=3&src=https%3A%2F%2Fexample.com%2Fx",
      "reject": "unsupported-version"
    },
    {
      "name": "reject-hint-nul",
      "raw": "dezoomify://open?v=2&src=https%3A%2F%2Fexample.com%2Fx&hint=a%00b",
      "reject": "invalid-source"
    }
  ]
}
