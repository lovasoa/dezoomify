{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario definition v1",
  "type": "object",
  "required": ["id", "description", "source_evidence", "input", "operation"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-/]*$" },
    "description": { "type": "string" },
    "source_evidence": {
      "type": "object",
      "required": ["snapshot", "path"],
      "properties": {
        "snapshot": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "mode": { "type": "string", "enum": ["automatic", "explicit"] },
        "format": { "type": "string" }
      }
    },
    "operation": { "type": "string", "enum": ["discover", "discover-download", "probe", "recognize", "proxy", "assemble"] },
    "expected": {
      "type": "object",
      "properties": {
        "format": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tile_count": { "type": "integer", "minimum": 1 },
        "tile_url_contains": { "type": "array", "items": { "type": "string" } },
        "data": { "type": "object" },
        "error_contains": { "type": "string" }
      }
    }
  }
}
