{
  "$comment": [
    "Shared cross-language oracle for desktop settings and trusted header",
    "validation: apps/desktop/src/settings.ts (parseHeadersText, validateSettings)",
    "and apps/desktop/src-tauri/src/settings.rs (parse_header_line, parse_settings).",
    "Consumed by the Rust test `policy_vectors_match_the_shared_oracle` and by",
    "apps/desktop/tests/policy-vectors.test.mjs; both assert every case.",
    "headerLines: accept is the parsed {name, value} entry, or null when the line",
    "is ignored without error. settings: accept echoes resulting settings fields.",
    "reject pins the user-visible reason string on each side (`ts` and `rust`).",
    "Where the two sides differ in wording only, both strings are pinned and the",
    "case comment explains why; verdicts must never differ.",
    "Keep the list bounded (15-25 cases) and update both validators and this file",
    "together."
  ],
  "headerLines": [
    {"name": "accept-basic", "line": "Referer: https://example.com/x", "accept": {"name": "referer", "value": "https://example.com/x"}},
    {"name": "accept-lowercases-name", "line": "X-Api-Key: v", "accept": {"name": "x-api-key", "value": "v"}},
    {"name": "accept-trims-padding", "line": "  Cookie :  secret=1  ", "accept": {"name": "cookie", "value": "secret=1"}},
    {"name": "accept-inner-colon", "line": "Referer: https://example.com/a:b", "accept": {"name": "referer", "value": "https://example.com/a:b"}},
    {"name": "accept-empty-value", "line": "X-Note:", "accept": {"name": "x-note", "value": ""}},
    {"name": "ignore-blank-line", "comment": "Blank lines are skipped without error or entry.", "line": "   ", "accept": null},
    {"name": "reject-no-colon", "line": "no colon here", "reject": {"ts": "headers line 1: expected \"Name: value\"", "rust": "invalid header (expected \"Name: value\"): line without colon"}},
    {"name": "reject-name-with-space", "line": "bad name: v", "reject": {"ts": "headers line 1: bad header name", "rust": "invalid header: bad name"}},
    {"name": "reject-empty-name", "line": ": v", "reject": {"ts": "headers line 1: bad header name", "rust": "invalid header: bad name"}},
    {"name": "reject-name-non-ascii", "comment": "Header names are ASCII tokens on both sides.", "line": "X-\u00d6: v", "reject": {"ts": "headers line 1: bad header name", "rust": "invalid header: bad name"}},
    {"name": "reject-name-too-long", "line": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: v", "reject": {"ts": "headers line 1: bad header name", "rust": "invalid header: bad name"}},
    {"name": "reject-value-cr", "line": "X: a\rb", "reject": {"ts": "headers line 1: value must not contain CR/LF/NUL", "rust": "invalid header: value must not contain CR/LF/NUL"}},
    {"name": "reject-value-nul", "line": "X: a\u0000b", "reject": {"ts": "headers line 1: value must not contain CR/LF/NUL", "rust": "invalid header: value must not contain CR/LF/NUL"}},
    {"name": "reject-value-too-long-ascii", "line": "X: ", "reject": {"ts": "headers line 1: value too long", "rust": "invalid header: value too long"}},
